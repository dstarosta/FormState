{
  "author": {
    "name": "Dmitry Starosta"
  },
  "license": "MIT",
  "name": "form-state",
  "sideEffects": [
    "./dist/form-schema.js"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.0.0",
  "files": [
    "src",
    "dist",
    "eslint",
    "!eslint/**/*.test.js"
  ],
  "main": "dist/form-state.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/form-state.js"
    },
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "import": "./eslint/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-ts": "node -e \"const v=require('typescript').version; if(v<'5.9.0'){console.error('❌ TS version '+v+' is too low. Need >= 5.9.0');process.exit(1)}\"",
    "build": "npm i && npm run check-ts && npm run prettier && npm run typecheck && npm run lint && npm run test && tsdown --config tsdown.types.config.ts && tsdown",
    "lint": "eslint .",
    "prettier": "prettier -c src/**",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "engines": {
    "tsc": ">= 5.9.0"
  },
  "peerDependencies": {
    "react": ">= 19.2.0",
    "react-dom": ">= 19.2.0",
    "zod": ">= 4.3.0 < 5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.10.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": ">= 9"
    },
    "eslint-plugin-react-hooks": {
      "eslint": ">= 9"
    }
  }
}
